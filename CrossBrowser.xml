<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Vtiger Cross Browser Suite" verbose="1">

    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="dashboard.DashboardSmokeTest"/>
            <class name="Campaign.CampaignSmokeTest"/>
            <class name="leads.LeadsSmokeTest"/>
            <class name="TroubleTickets.TroubleTicketsSmokeTest"/>
        </classes>
    </test>

    <test name="Firefox Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="dashboard.DashboardSmokeTest"/>
            <class name="Campaign.CampaignSmokeTest"/>
            <class name="leads.LeadsSmokeTest"/>
            <class name="TroubleTickets.TroubleTicketsSmokeTest"/>
        </classes>
    </test>

</suite>


